<atlassian-plugin key="org.openpr.jira.openpr-for-jira" name="OpenPR for Jira" plugins-version="2">
  <plugin-info>
    <description>Read-only pull request viewer for Jira Data Center</description>
    <version>0.1.0-SNAPSHOT</version>
    <vendor name="OpenPR contributors" url="https://github.com/onurhancihan/openpr-for-jira"/>
  </plugin-info>
  <web-panel key="openpr-issue-panel" name="OpenPR Pull Requests" location="atl.jira.view.issue.right.context" weight="200">
    <description>Read-only OpenPR panel for Jira issue view.</description>
    <resource name="view" type="velocity" location="/templates/pr-panel.vm"/>
  </web-panel>
</atlassian-plugin>
