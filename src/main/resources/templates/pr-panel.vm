<section class="module openpr-issue-panel" aria-label="OpenPR pull requests">
  <div class="mod-header"><h3>GitHub Pull Requests</h3></div>
  <div class="mod-content">
    #if($openprRows && !$openprRows.isEmpty())
      <ul class="item-details">
      #foreach($pr in $openprRows)
        <li><a href="$pr.url" target="_blank" rel="noopener noreferrer">#$pr.number $pr.title</a>
          <span class="description">$pr.state &middot; $pr.author &middot; $pr.branch</span>
        </li>
      #end
      </ul>
    #else
      <p class="description">$openprStatus</p>
    #end
  </div>
</section>
